---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Emblem Creator">
  <div class="max-w-4xl mx-auto py-12 px-4 md:px-6 space-y-12">
    
    <section class="text-center">
      <h1 class="text-[clamp(40px,6vw,80px)] font-black italic uppercase leading-[0.8] text-white tracking-tighter drop-shadow-lg mb-4">
        Emblem <span class="text-gold">Creator</span>
      </h1>
      <p class="text-zinc-400 font-bold uppercase tracking-widest text-sm italic">
        Convert Images to Custom GTA Crew Emblems
      </p>
    </section>

    <div class="bg-zinc-900/40 backdrop-blur-md border border-zinc-700/50 p-8 rounded-[2.5rem] shadow-2xl space-y-8">
      
      <!-- Upload Section -->
      <div class="space-y-4">
        <label class="text-gold font-black uppercase tracking-widest text-[10px] drop-shadow-sm flex items-center gap-2">
          <i data-lucide="image" class="w-4 h-4"></i>
          Select Source Image
        </label>
        
        <div class="relative border-2 border-dashed border-zinc-700/50 rounded-2xl p-8 text-center hover:border-gold/50 transition-colors bg-black/30 overflow-hidden min-h-[160px] flex items-center justify-center group">
          <input type="file" id="imageInput" accept="image/*" class="opacity-0 absolute w-0 h-0" />
          
          <!-- Image Preview -->
          <img id="imagePreview" src="" class="hidden absolute inset-0 w-full h-full object-contain p-4 z-0 opacity-50 group-hover:opacity-20 transition-opacity" />
          
          <label for="imageInput" class="cursor-pointer flex flex-col items-center gap-3 relative z-10 w-full">
            <i data-lucide="upload-cloud" class="w-8 h-8 text-zinc-500" id="uploadIcon"></i>
            <span class="text-white font-bold uppercase text-sm tracking-tight" id="uploadText">Click to Upload Image</span>
            <span class="text-zinc-500 text-xs font-mono" id="uploadSubtext">PNG, JPG, SVG up to 5MB</span>
          </label>
        </div>
      </div>

      <!-- Settings Grid -->
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <label class="text-gold font-black uppercase tracking-widest text-[10px] drop-shadow-sm flex items-center gap-2">
            <i data-lucide="sliders" class="w-4 h-4"></i>
            Detail Level
          </label>
          <input type="range" id="detailSlider" min="1" max="10" value="5" class="w-full accent-gold bg-zinc-800 rounded-lg appearance-none h-2" />
          <div class="flex justify-between text-[10px] text-zinc-500 font-bold uppercase">
            <span>Simple</span>
            <span>Complex</span>
          </div>
        </div>

        <div class="space-y-4">
          <label class="text-gold font-black uppercase tracking-widest text-[10px] drop-shadow-sm flex items-center gap-2">
            <i data-lucide="palette" class="w-4 h-4"></i>
            Color Smoothing
          </label>
          <input type="range" id="smoothSlider" min="1" max="10" value="5" class="w-full accent-gold bg-zinc-800 rounded-lg appearance-none h-2" />
          <div class="flex justify-between text-[10px] text-zinc-500 font-bold uppercase">
            <span>Sharp</span>
            <span>Smooth</span>
          </div>
        </div>
      </div>

      <!-- Action Button & Progress Bar -->
      <div class="pt-4 border-t border-zinc-700/50 space-y-4">
        <button id="generateBtn" class="w-full bg-gold hover:bg-gold/80 text-black py-4 rounded-xl font-black uppercase italic tracking-tighter text-lg transition-all shadow-[0_0_30px_-5px_rgba(212,175,55,0.4)]">
          Generate Emblem Code
        </button>

        <div id="progressContainer" class="hidden space-y-2">
          <div class="flex justify-between text-[10px] text-zinc-400 font-bold uppercase tracking-widest">
            <span id="progressStatus">Initializing...</span>
            <span id="progressPercent">0%</span>
          </div>
          <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
            <div id="progressBar" class="bg-gold h-1.5 rounded-full w-0 transition-all duration-200"></div>
          </div>
        </div>
      </div>
      
    </div>

    <!-- Output Section -->
    <div class="bg-black/60 backdrop-blur-xl border border-gold/40 rounded-[2.5rem] overflow-hidden shadow-2xl hidden" id="outputSection">
      <div class="bg-zinc-900/60 p-6 border-b border-gold/20 flex justify-between items-center">
        <h3 class="text-xl font-black italic uppercase text-white tracking-tighter drop-shadow-md">
          Generated <span class="text-gold">Code</span>
        </h3>
        <button id="copyBtn" class="bg-zinc-800 hover:bg-zinc-700 text-gold px-4 py-2 rounded-lg font-bold uppercase text-[10px] tracking-widest transition-colors flex items-center gap-2 border border-zinc-600">
          <i data-lucide="copy" class="w-3 h-3"></i>
          Copy to Clipboard
        </button>
      </div>
      <div class="p-6">
        <textarea id="outputCode" readonly class="w-full h-64 bg-black border border-zinc-800 rounded-xl p-4 text-zinc-300 font-mono text-xs focus:outline-none focus:border-gold/50 resize-none overflow-y-auto"></textarea>
      </div>
    </div>

  </div>
</MainLayout>

<script is:inline>
  function initEmblemCreator() {
    if (window.lucide) {
      window.lucide.createIcons();
    }

    const generateBtn = document.getElementById('generateBtn');
    const outputSection = document.getElementById('outputSection');
    const copyBtn = document.getElementById('copyBtn');
    const outputCode = document.getElementById('outputCode');
    
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const uploadText = document.getElementById('uploadText');
    const uploadIcon = document.getElementById('uploadIcon');
    const uploadSubtext = document.getElementById('uploadSubtext');

    const progressContainer = document.getElementById('progressContainer');
    const progressBar = document.getElementById('progressBar');
    const progressPercent = document.getElementById('progressPercent');
    const progressStatus = document.getElementById('progressStatus');

    // Handle file selection and preview
    if (imageInput && uploadText) {
      imageInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        
        if (file) {
          uploadText.textContent = file.name;
          uploadText.classList.add('text-gold');
          uploadIcon.style.display = 'none';
          uploadSubtext.style.display = 'none';
          
          // Read image for preview
          const reader = new FileReader();
          reader.onload = function(event) {
            imagePreview.src = event.target.result;
            imagePreview.classList.remove('hidden');
          }
          reader.readAsDataURL(file);
        } else {
          uploadText.textContent = 'Click to Upload Image';
          uploadText.classList.remove('text-gold');
          uploadIcon.style.display = 'block';
          uploadSubtext.style.display = 'block';
          imagePreview.classList.add('hidden');
          imagePreview.src = '';
        }
      });
    }

    // Handle Generation and Progress Bar
    if (generateBtn) {
      generateBtn.addEventListener('click', () => {
        // Reset and show progress bar
        outputSection.classList.add('hidden');
        progressContainer.classList.remove('hidden');
        generateBtn.disabled = true;
        generateBtn.classList.add('opacity-50', 'cursor-not-allowed');
        
        let progress = 0;
        progressBar.style.width = '0%';
        progressPercent.textContent = '0%';
        progressStatus.textContent = 'Analyzing image colors...';

        const interval = setInterval(() => {
          progress += Math.floor(Math.random() * 15) + 5;
          if (progress > 100) progress = 100;
          
          progressBar.style.width = `${progress}%`;
          progressPercent.textContent = `${progress}%`;

          // Update status text based on progress
          if (progress > 25 && progress < 60) {
            progressStatus.textContent = 'Generating SVG paths...';
          } else if (progress >= 60 && progress < 90) {
            progressStatus.textContent = 'Formatting Rockstar emblem code...';
          } else if (progress >= 90) {
            progressStatus.textContent = 'Finalizing...';
          }

          if (progress === 100) {
            clearInterval(interval);
            
            setTimeout(() => {
              progressContainer.classList.add('hidden');
              generateBtn.disabled = false;
              generateBtn.classList.remove('opacity-50', 'cursor-not-allowed');
              
              outputSection.classList.remove('hidden');
              outputCode.value = "// Your generated Rockstar Social Club emblem code will appear here.\n// Paste this into the browser console on the emblem editor page.\n\nconsole.log('Code execution started...');";
            }, 500);
          }
        }, 300);
      });
    }

    // Copy to clipboard
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        outputCode.select();
        document.execCommand('copy');
        
        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i data-lucide="check" class="w-3 h-3"></i> Copied!';
        if (window.lucide) window.lucide.createIcons();
        
        setTimeout(() => {
          copyBtn.innerHTML = originalText;
          if (window.lucide) window.lucide.createIcons();
        }, 2000);
      });
    }
  }

  window.addEventListener('load', initEmblemCreator);
  document.addEventListener('astro:page-load', initEmblemCreator);
</script>