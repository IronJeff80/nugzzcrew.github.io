---
import MainLayout from '../layouts/MainLayout.astro';
import gtaData from '../data/gta-weekly.json';

const eventTitle = gtaData.eventTitle || gtaData.eventtitle || "GTA Weekly Showcase";
const eventDates = gtaData.eventDates || gtaData.weekEnding || gtaData.weekending;
const gtaPlus = gtaData.gtaPlus || gtaData.gtaplus;
