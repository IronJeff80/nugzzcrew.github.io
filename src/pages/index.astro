---
import MainLayout from '../layouts/MainLayout.astro';

const channelJoinUrl = "https://www.youtube.com/channel/UCYNmnbEgm3G0m4avmwz_4Eg/join?v=dummy";
---

<MainLayout title="Home" description="Official Nugzz Crew homepage — live streams, GTA weekly bonuses, community tools, and the Fam Bam.">
  <section class="max-w-4xl mx-auto py-12 md:py-20 px-4 md:px-6 text-center">
    
    <h1 class="text-[clamp(32px,10vw,60px)] mb-4 tracking-tighter uppercase font-black italic leading-[0.9]">
      <span class="text-white">Fam</span> <span class="text-gold">Bam Central</span>
    </h1>
    
    <p class="text-base md:text-xl text-zinc-400 mb-10 italic max-w-2xl mx-auto">
      "Streaming, GTA Updates, and the best community in the game."
    </p>
    
    <!-- Video Wrapper with Theater Mode -->
    <div id="video-container" class="relative aspect-video w-full rounded-xl md:rounded-2xl border border-zinc-800 mb-4 overflow-hidden bg-black shadow-[0_0_50px_-12px_rgba(212,175,55,0.3)] group">
      <img 
        id="offline-placeholder" 
        src="/images/offline.png" 
        alt="Stream is currently offline" 
        class="absolute inset-0 w-full h-full object-cover z-10"
      />
      <iframe 
        id="yt-video-frame" 
        src="about:blank" 
        allowfullscreen 
        class="absolute inset-0 w-full h-full z-20 hidden"
      ></iframe>

      <!-- Live Badge -->
      <div id="live-badge" class="absolute top-3 left-3 z-30 hidden items-center gap-2 bg-black/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-red-500/50">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-white">LIVE</span>
      </div>

      <!-- Theater Mode Button -->
      <button 
        id="theater-btn"
        class="absolute bottom-3 right-3 z-30 opacity-0 group-hover:opacity-100 transition-opacity bg-black/70 hover:bg-black/90 text-white text-xs uppercase tracking-widest px-3 py-1.5 rounded-lg border border-zinc-700 hover:border-gold flex items-center gap-1.5"
        aria-label="Toggle theater mode"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
        Theater
      </button>
    </div>

    <!-- Cards with 3D Tilt -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-8">
      <a href="/gta" class="tilt-card p-6 md:p-8 bg-zinc-900 border border-zinc-800 rounded-2xl hover:border-gold transition-all group text-left block">
        <h2 class="text-xl md:text-2xl group-hover:text-gold transition-colors uppercase font-black italic">
          <span class="text-white">GTA</span> <span class="text-gold">Bonuses &rarr;</span>
        </h2>
        <p class="text-zinc-500 mt-2 text-sm md:text-base">Get the latest on bonuses, car meets, and robberies.</p>
      </a>

      <a 
        href={channelJoinUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="tilt-card p-6 md:p-8 bg-zinc-900 border border-zinc-800 rounded-2xl hover:border-gold transition-all group text-left block"
      >
        <h2 class="text-xl md:text-2xl group-hover:text-gold transition-colors uppercase font-black italic">
          <span class="text-white">The</span> <span class="text-gold">Fam Bam &rarr;</span>
        </h2>
        <p class="text-zinc-500 mt-2 text-sm md:text-base">Catch every live stream and join the best community on YouTube.</p>
      </a>
    </div>
  </section>
</MainLayout>

<script is:inline>
  // ===== Live Status WebSocket =====
  function connectBot() {
    const ws = new WebSocket("wss://wss.officialnugzzcrew.com/");

    ws.onopen = () => {
      ws.send(JSON.stringify({ "request": "Subscribe", "events": { "general": ["Custom"] }, "id": "SubRequest" }));
      setTimeout(() => {
        ws.send(JSON.stringify({ "request": "DoAction", "action": { "name": "Web_Request_Status" }, "id": "StatusCheck" }));
      }, 1000);
    };

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.data && msg.data.data && msg.data.data.name === "LiveStatusUpdate") {
          const data = msg.data.data;
          const videoFrame = document.getElementById('yt-video-frame');
          const placeholderImg = document.getElementById('offline-placeholder');
          const liveBadge = document.getElementById('live-badge');

          if (data.isLive === true && data.videoId && data.videoId.trim() !== "") {
            videoFrame.classList.remove('hidden');
            videoFrame.src = `https://www.youtube.com/embed/${data.videoId}?autoplay=1&mute=1`;
            placeholderImg.style.display = 'none';
            liveBadge.classList.remove('hidden');
            liveBadge.classList.add('flex');
          } else {
            videoFrame.classList.add('hidden');
            videoFrame.src = "about:blank";
            placeholderImg.style.display = 'block';
            liveBadge.classList.add('hidden');
            liveBadge.classList.remove('flex');
          }
        }
      } catch (e) { console.log("Parsing error:", e); }
    };
    
    ws.onclose = () => setTimeout(connectBot, 5000);
  }
  window.addEventListener('load', connectBot);

  // ===== Theater Mode =====
  const theaterBtn = document.getElementById('theater-btn');
  const videoContainer = document.getElementById('video-container');
  let isTheater = false;

  theaterBtn?.addEventListener('click', () => {
    isTheater = !isTheater;
    if (isTheater) {
      videoContainer.classList.add('theater-mode');
      document.body.style.overflow = 'hidden';
      theaterBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg> Exit`;
    } else {
      videoContainer.classList.remove('theater-mode');
      document.body.style.overflow = '';
      theaterBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg> Theater`;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isTheater) theaterBtn?.click();
  });
</script>

<style>
  #video-container.theater-mode {
    position: fixed;
    inset: 0;
    z-index: 100;
    max-width: none;
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }
  #video-container.theater-mode iframe,
  #video-container.theater-mode img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    aspect-ratio: 16/9;
  }
</style>