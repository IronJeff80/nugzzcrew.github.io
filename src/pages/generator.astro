const wheelImages = {
  "Bennys Bespoke": "/images/wheels/bennys-bespoke.png",
  "Bennys Originals": "/images/wheels/bennys-originals.png",
  "Race": "/images/wheels/race.png",
  "Bike": "/images/wheels/bike.png",
  "High End": "/images/wheels/high-end.png",
  "Lowrider": "/images/wheels/lowrider.png",
  "Muscle": "/images/wheels/muscle.png",
  "Offroad": "/images/wheels/offroad.png",
  "Sport": "/images/wheels/sport.png",
  "Street": "/images/wheels/street.png",
  "SUV": "/images/wheels/suv.png",
  "Track": "/images/wheels/track.png",
  "Tuner": "/images/wheels/tuner.png"
};

const preferredRimCats = ["Bennys Bespoke", "Bennys Originals", "Race"];
const randomizableRimCats = Object.keys(wheelCategories).filter(c => c !== "Bike");
const tireDesigns = ["None", "White lines", "Classic", "Retro", "Red", "Blue"];
const windowTints = ["Clear", "Green"];
const neonOptions = ["Crew", "Pure White", "Blue", "Electric Blue", "Mint Green", "Lime Green", "Yellow", "Golden Shower", "Orange", "Red", "Poncho Pink", "Hot Pink", "Purple", "Blacklight"];

const vividNames = ["Blaze Red", "Candy Red", "Bright Green", "Lime Green", "Race Yellow", "Sunrise Orange", "Hot Pink", "Fluorescent Blue", "Pfister Pink", "Ultra Blue", "Lightning Blue", "Dew Yellow", "Gasoline Green", "Bright Purple", "Orange", "Yellow", "Green Bright", "Epsilon Blue"];
const realisticNames = ["Black", "Graphite", "Anthracite Gray", "Black Steel", "Cast Iron Silver", "Shadow Silver", "Midnight Blue", "Dark Blue", "Harbor Blue", "BeechWood Brown", "Bison Brown", "Chocolate Brown", "Saddle Brown", "Olive Drab", "Foliage Green", "Desert Tan", "Gun Metal", "Rolled Steel"];
---

<MainLayout title="DMO Generator" description="Unselected-only GTA Online DMO generator. Official Nugzz Crew.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-header text-gold uppercase tracking-tighter mb-2">DMO Generator</h1>
      <p class="text-zinc-400 uppercase text-xs tracking-[0.2em]">Primary: all unselected • Secondary: only the 59 that drop unselected • Custom RGB otherwise</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-7 bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 space-y-6">
        
        <div class="flex gap-3">
          <button id="randomVivid" type="button" class="flex-1 bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">
            Random Vivid
          </button>
          <button id="randomRealistic" type="button" class="flex-1 bg-gradient-to-r from-zinc-600 to-zinc-800 hover:from-zinc-500 hover:to-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">
            Random Realistic
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Vehicle:</label>
            <input type="text" id="vehicle" placeholder="e.g. Buffalo STX" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Plate Text (always Yankton):</label>
              <input type="text" id="plate" maxlength="8" placeholder="NUGZZ" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm uppercase font-mono outline-none focus:border-gold" />
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Window Tint:</label>
              <select id="windows" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {windowTints.map(w => <option value={w}>{w}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Headlight Color:</label>
              <select id="headlights" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {neonOptions.filter(c => c !== 'Crew').map(h => <option value={h}>{h}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Paint Texture (for custom RGB/HEX):</label>
              <select id="texture" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {textureOrder.filter(t => byTexture[t]).map(t => <option value={t}>{t}</option>)}
              </select>
            </div>
          </div>
          <p class="text-[9px] text-zinc-500 -mt-2">Primary can use any unselected named color. Secondary only shows the colors that actually drop unselected as secondary. Everything else must use Custom RGB/HEX.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Primary (all unselected):</label>
              <div class="flex gap-2 items-stretch">
                <select id="primary" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="primaryPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Secondary (limited unselected only):</label>
              <div class="flex gap-2 items-stretch">
                <select id="secondary" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="secondaryPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700">
            <input type="checkbox" id="crewBoth" class="w-4 h-4 accent-gold cursor-pointer" />
            <label for="crewBoth" class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest">Same custom color on BOTH Primary & Secondary</label>
          </div>

          <div id="rgbInputArea" class="bg-gold/10 p-4 rounded-xl border border-gold/50" style="display:none;">
            <label class="block text-[10px] text-gold uppercase font-black mb-2">Custom Paint Color (RGB or HEX) on selected texture:</label>
            <input type="text" id="sharedRgb" placeholder="212, 175, 55  or  #d4af37" class="w-full bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Pearlescent (unselected only):</label>
              <div class="flex gap-2 items-stretch">
                <select id="pearl" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="pearlPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Interior (unselected only):</label>
              <div class="flex gap-2 items-stretch">
                <select id="interior" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="interiorPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Wheel Category:</label>
              <select id="wheelCategory" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {Object.keys(wheelCategories).map(cat => <option value={cat}>{cat}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Rim Style:</label>
              <select id="rimStyle" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <img id="wheelThumb" src="/images/wheels/bennys-bespoke.png" alt="Wheel category" class="w-24 h-16 object-cover rounded border border-zinc-700 cursor-pointer hover:border-gold transition-all" />
            <button id="expandWheel" type="button" class="text-[10px] text-zinc-400 uppercase tracking-widest hover:text-gold">Click to expand full grid</button>
          </div>

          <div id="wheelExpanded" class="hidden mt-2">
            <img id="wheelFull" src="/images/wheels/bennys-bespoke.png" alt="Full wheel grid" class="w-full rounded-lg border border-zinc-700 max-h-96 object-contain bg-black" />
            <button id="collapseWheel" type="button" class="mt-2 text-[10px] text-zinc-500 uppercase tracking-widest hover:text-gold">Collapse</button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Rim Color (unselected only):</label>
              <div class="flex gap-2 items-stretch">
                <select id="rimColor" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="rimColorPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Tire Design:</label>
              <select id="tires" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {tireDesigns.map(d => <option value={d}>{d}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Neon:</label>
              <div class="flex gap-2 items-stretch">
                <select id="neon" class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                  {neonOptions.map(c => <option value={c}>{c}</option>)}
                </select>
                <div id="neonPrev" class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"></div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700 h-[46px]">
              <input type="checkbox" id="activator" class="w-4 h-4 accent-gold cursor-pointer" />
              <label for="activator" class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest">Activator</label>
            </div>
          </div>

          <div id="neonRgbArea" class="bg-blue-500/10 p-4 rounded-xl border border-blue-500/50" style="display:none;">
            <label class="block text-[10px] text-blue-400 uppercase font-black mb-2">Neon Custom Color (RGB or HEX):</label>
            <input type="text" id="neonRgb" placeholder="0, 255, 255  or  #00ffff" class="w-full bg-black border-2 border-blue-500 rounded-lg p-3 text-white text-sm font-mono outline-none" />
          </div>
        </div>

        <button id="mainGenerateBtn" type="button" class="w-full bg-gold hover:bg-white text-black font-black uppercase py-5 rounded-xl tracking-widest transition-all">
          Generate DMO Spec
        </button>
      </div>

      <div class="lg:col-span-5">
        <div class="sticky top-24">
          <div class="bg-black border-2 border-dashed border-zinc-800 rounded-3xl p-6">
            <textarea id="finalOutput" readonly class="bg-transparent font-mono text-sm h-[640px] w-full resize-none outline-none border-none text-gold" placeholder="Ready for NUGZZ..."></textarea>
            <button id="copyFinal" type="button" class="mt-4 w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold uppercase py-4 rounded-xl transition-all">
              Copy To Clipboard
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ allUnselected, wheelCategories, byTexture, preferredRimCats, randomizableRimCats, wheelImages, vividNames, realisticNames }}>
  const hexMap = {};
  allUnselected.forEach(c => { hexMap[c.name] = c.hex; });

  function parseColor(input) {
    if (!input) return null;
    input = input.trim();
    if (input.startsWith('#')) {
      const hex = input.slice(1);
      if (hex.length === 6) {
        const r = parseInt(hex.slice(0,2), 16);
        const g = parseInt(hex.slice(2,4), 16);
        const b = parseInt(hex.slice(4,6), 16);
        if (!isNaN(r) && !isNaN(g) && !isNaN(b)) return `rgb(${r}, ${g}, ${b})`;
      }
    }
    if (input.includes(',')) {
      const parts = input.split(',').map(n => parseInt(n.trim()));
      if (parts.length === 3 && parts.every(n => !isNaN(n) && n >= 0 && n <= 255)) {
        return `rgb(${parts.join(', ')})`;
      }
    }
    return null;
  }

  function getUnselectedForFlag(flag) {
    return allUnselected.filter(c => !c[flag]);
  }

  function pickFrom(list, preferred) {
    if (!list || !list.length) return null;
    const preferredHits = list.filter(c => preferred.some(p => c.name.toLowerCase().includes(p.toLowerCase())));
    const pool = preferredHits.length ? preferredHits : list;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function populatePrimary() {
    const sel = document.getElementById('primary');
    const unique = [...new Set(allUnselected.map(c => c.name))];
    sel.innerHTML = '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' +
      unique.map(name => `<option value="${name}">${name}</option>`).join('');
  }

  function populateSecondary() {
    const sel = document.getElementById('secondary');
    const list = getUnselectedForFlag('secondary');
    const unique = [...new Set(list.map(c => c.name))];
    sel.innerHTML = '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' +
      unique.map(name => `<option value="${name}">${name}</option>`).join('');
  }

  function populateUnselectedOnly(selectId, flag) {
    const sel = document.getElementById(selectId);
    const list = getUnselectedForFlag(flag);
    const unique = [...new Set(list.map(c => c.name))];
    sel.innerHTML = '<option value="">-- Unselected --</option>' +
      unique.map(name => `<option value="${name}">${name}</option>`).join('');
  }

  function getColorForPreview(id) {
    const sel = document.getElementById(id);
    if (!sel) return '#111';
    const val = sel.value;
    if (val === 'Custom' || val === 'Crew') {
      const input = id === 'neon' ? document.getElementById('neonRgb').value : document.getElementById('sharedRgb').value;
      return parseColor(input) || '#666';
    }
    return hexMap[val] || '#111';
  }

  function refreshPreviews() {
    ['primary','secondary','pearl','interior','rimColor','neon'].forEach(id => {
      const box = document.getElementById(id + 'Prev');
      if (box) box.style.backgroundColor = getColorForPreview(id);
    });

    const paintCustom = document.getElementById('primary').value === 'Custom' || 
                        document.getElementById('secondary').value === 'Custom' || 
                        document.getElementById('crewBoth').checked;
    document.getElementById('rgbInputArea').style.display = paintCustom ? 'block' : 'none';

    const neonCustom = document.getElementById('neon').value === 'Crew';
    document.getElementById('neonRgbArea').style.display = neonCustom ? 'block' : 'none';
  }

  function refreshAll() {
    populatePrimary();
    populateSecondary();
    populateUnselectedOnly('pearl', 'pearl');
    populateUnselectedOnly('interior', 'interior');
    populateUnselectedOnly('rimColor', 'rim');
    refreshPreviews();
  }

  function populateRims() {
    const cat = document.getElementById('wheelCategory').value;
    const sel = document.getElementById('rimStyle');
    const styles = wheelCategories[cat] || [];
    sel.innerHTML = styles.map(s => `<option value="${s}">${s}</option>`).join('');
    const imgSrc = wheelImages[cat] || wheelImages["Bennys Bespoke"];
    document.getElementById('wheelThumb').src = imgSrc;
    document.getElementById('wheelFull').src = imgSrc;
  }

  function randomFrom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function randomBuild(vivid) {
    const texture = vivid 
      ? randomFrom(['Other','Matte','Metallic','Worn']) 
      : randomFrom(['Metallic','Utility','Worn','Metals']);
    document.getElementById('texture').value = texture;
    refreshAll();

    const preferred = vivid ? vividNames : realisticNames;

    // Primary: any unselected
    const primPick = pickFrom(allUnselected, preferred);
    if (primPick && Math.random() > 0.25) {
      document.getElementById('primary').value = primPick.name;
    } else {
      document.getElementById('primary').value = 'Custom';
    }

    // Secondary: ONLY the ones that drop unselected as secondary
    const secList = getUnselectedForFlag('secondary');
    const secPick = pickFrom(secList, preferred);
    if (secPick && Math.random() > 0.35) {
      document.getElementById('secondary').value = secPick.name;
    } else {
      document.getElementById('secondary').value = 'Custom';
    }

    if (document.getElementById('primary').value === 'Custom' || document.getElementById('secondary').value === 'Custom') {
      let r, g, b;
      if (vivid) {
        r = Math.floor(150 + Math.random()*105);
        g = Math.floor(Math.random()*200);
        b = Math.floor(Math.random()*200);
      } else {
        r = Math.floor(Math.random()*80);
        g = Math.floor(Math.random()*80);
        b = Math.floor(Math.random()*80);
      }
      document.getElementById('sharedRgb').value = Math.random() > 0.5 
        ? `${r}, ${g}, ${b}` 
        : `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
    }

    const pearlPick = pickFrom(getUnselectedForFlag('pearl'), vivid ? preferred : ['Black', 'Graphite']);
    if (pearlPick) document.getElementById('pearl').value = pearlPick.name;

    const rimPick = pickFrom(getUnselectedForFlag('rim'), preferred);
    if (rimPick) document.getElementById('rimColor').value = rimPick.name;

    const intPick = pickFrom(getUnselectedForFlag('interior'), preferred);
    if (intPick) document.getElementById('interior').value = intPick.name;

    if (Math.random() < 0.6) {
      document.getElementById('neon').value = 'Crew';
      const r = Math.floor(Math.random()*256);
      const g = Math.floor(Math.random()*256);
      const b = Math.floor(Math.random()*256);
      document.getElementById('neonRgb').value = Math.random() > 0.5 ? `${r}, ${g}, ${b}` : `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
    }

    const cat = vivid ? randomFrom(preferredRimCats) : randomFrom(randomizableRimCats);
    document.getElementById('wheelCategory').value = cat;
    populateRims();
    const styles = wheelCategories[cat];
    if (styles.length) document.getElementById('rimStyle').value = randomFrom(styles);

    refreshPreviews();
  }

  document.getElementById('texture').addEventListener('change', refreshAll);
  document.getElementById('wheelCategory').addEventListener('change', populateRims);
  ['primary','secondary','pearl','interior','rimColor','neon','sharedRgb','neonRgb'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', refreshPreviews);
    document.getElementById(id)?.addEventListener('input', refreshPreviews);
  });
  document.getElementById('crewBoth')?.addEventListener('change', refreshPreviews);

  document.getElementById('randomVivid').addEventListener('click', () => randomBuild(true));
  document.getElementById('randomRealistic').addEventListener('click', () => randomBuild(false));

  document.getElementById('wheelThumb').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.toggle('hidden');
  });
  document.getElementById('expandWheel').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.remove('hidden');
  });
  document.getElementById('collapseWheel').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.add('hidden');
  });

  document.getElementById('mainGenerateBtn').addEventListener('click', () => {
    const get = id => document.getElementById(id).value || 'N/A';
    const paintColor = document.getElementById('sharedRgb').value || 'N/A';
    const neonColor = document.getElementById('neonRgb').value || 'N/A';
    const output = `=== DMO SPEC (UNSELECTED ONLY) ===
Vehicle: ${get('vehicle')}
Plate: ${get('plate')} (North Yankton)
Windows: ${get('windows')}
Headlights: ${get('headlights')}
Texture: ${get('texture')}
Primary: ${get('primary')}
Secondary: ${get('secondary')}
Pearlescent: ${get('pearl')}
Interior: ${get('interior')}
Wheel Category: ${get('wheelCategory')}
Rim Style: ${get('rimStyle')}
Rim Color: ${get('rimColor')}
Tires: ${get('tires')}
Neon: ${get('neon')}
Activator: ${document.getElementById('activator').checked ? 'Yes' : 'No'}
Same Custom on Both: ${document.getElementById('crewBoth').checked ? 'Yes' : 'No'}
Paint Custom (RGB/HEX): ${paintColor}
Neon Custom (RGB/HEX): ${neonColor}
`;
    document.getElementById('finalOutput').value = output;
  });

  document.getElementById('copyFinal').addEventListener('click', () => {
    const box = document.getElementById('finalOutput');
    box.select();
    document.execCommand('copy');
    alert('Copied!');
  });

  refreshAll();
  populateRims();
</script>
