---
import MainLayout from "../layouts/MainLayout.astro";
import colors from "../data/colors.json";

const allUnselected = colors.filter(
  (c) => !c.primary || !c.secondary || !c.pearl || !c.rim || !c.interior,
);

const byTexture = {};
allUnselected.forEach((c) => {
  if (!byTexture[c.texture]) byTexture[c.texture] = [];
  byTexture[c.texture].push(c);
});

