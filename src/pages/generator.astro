---

<MainLayout
  title="DMO Generator"
  description="GTA Online DMO generator. Official Nugzz Crew."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-header uppercase tracking-tighter mb-2">
        <span class="text-white">DMO</span>
        <span class="text-gold">Generator</span>
      </h1>
      <p class="text-zinc-400 uppercase text-xs tracking-[0.2em]">
        Vivid or Realistic • Custom RGB/HEX on any texture
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div
        class="lg:col-span-7 bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 space-y-6"
      >
        <div class="flex gap-3">
          <button
            id="randomVivid"
            type="button"
            class="flex-1 bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all"
          >
            Random Vivid
          </button>
          <button
            id="randomRealistic"
            type="button"
            class="flex-1 bg-gradient-to-r from-zinc-600 to-zinc-800 hover:from-zinc-500 hover:to-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all"
          >
            Random Realistic
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-[10px] text-gold uppercase font-black mb-1"
              >Vehicle:</label
            >
            <input
              type="text"
              id="vehicle"
              placeholder="e.g. Buffalo STX"
              class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Plate Text (8 chars, blank = Blankton):</label
              >
              <input
                type="text"
                id="plate"
                maxlength="8"
                placeholder="NUGZZ"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm uppercase font-mono outline-none focus:border-gold"
              />
            </div>
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Window Tint:</label
              >
              <select
                id="windows"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              >
                {windowTints.map((w) => <option value={w}>{w}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Headlight Color:</label
              >
              <select
                id="headlights"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              >
                {
                  neonOptions
                    .filter((c) => c !== "Crew")
                    .map((h) => <option value={h}>{h}</option>)
                }
              </select>
            </div>
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Paint Texture (for custom RGB/HEX):</label
              >
              <select
                id="texture"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              >
                {
                  textureOrder
                    .filter((t) => byTexture[t])
                    .map((t) => <option value={t}>{t}</option>)
                }
              </select>
            </div>
          </div>
          <p class="text-[9px] text-zinc-500 -mt-2">
            Named colors only exist on their own texture. To get a color that
            isn't listed under that texture, use Custom RGB/HEX.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Primary:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="primary"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                ></select>
                <div
                  id="primaryPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Secondary:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="secondary"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                ></select>
                <div
                  id="secondaryPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
          </div>

          <div
            class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700"
          >
            <input
              type="checkbox"
              id="crewBoth"
              class="w-4 h-4 accent-gold cursor-pointer"
            />
            <label
              for="crewBoth"
              class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest"
              >Same custom color on BOTH Primary & Secondary</label
            >
          </div>

          <div
            id="rgbInputArea"
            class="bg-gold/10 p-4 rounded-xl border border-gold/50"
            style="display:none;"
          >
            <label class="block text-[10px] text-gold uppercase font-black mb-2"
              >Custom Paint Color (RGB or HEX) on selected texture:</label
            >
            <div class="flex gap-2 items-stretch">
              <input
                type="text"
                id="sharedRgb"
                placeholder="212, 175, 55  or  #d4af37"
                class="min-w-0 flex-1 bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none"
              />
              <div
                id="sharedRgbPrev"
                class="w-12 h-12 rounded border border-gold/60 bg-zinc-800 flex-shrink-0"
              >
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Pearlescent:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="pearl"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                ></select>
                <div
                  id="pearlPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Interior:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="interior"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                ></select>
                <div
                  id="interiorPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Wheel Category:</label
              >
              <select
                id="wheelCategory"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              >
                {
                  Object.keys(wheelCategories).map((cat) => (
                    <option value={cat}>{cat}</option>
                  ))
                }
              </select>
            </div>
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Rim Style:</label
              >
              <select
                id="rimStyle"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              ></select>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <img
              id="wheelThumb"
              src="/images/wheels/bennys-bespoke.png"
              alt="Wheel category"
              class="w-24 h-16 object-cover rounded border border-zinc-700 cursor-pointer hover:border-gold transition-all"
            />
            <button
              id="expandWheel"
              type="button"
              class="text-[10px] text-zinc-400 uppercase tracking-widest hover:text-gold"
              >Click to expand full grid</button
            >
          </div>

          <div id="wheelExpanded" class="hidden mt-2">
            <img
              id="wheelFull"
              src="/images/wheels/bennys-bespoke.png"
              alt="Full wheel grid"
              class="w-full rounded-lg border border-zinc-700 max-h-96 object-contain bg-black"
            />
            <button
              id="collapseWheel"
              type="button"
              class="mt-2 text-[10px] text-zinc-500 uppercase tracking-widest hover:text-gold"
              >Collapse</button
            >
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Rim Color:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="rimColor"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                ></select>
                <div
                  id="rimColorPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
            <div>
              <label
                class="block text-[10px] text-gold uppercase font-black mb-1"
                >Tire Design:</label
              >
              <select
                id="tires"
                class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
              >
                {tireDesigns.map((d) => <option value={d}>{d}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
            <div class="space-y-1">
              <label class="text-[10px] text-gold uppercase font-black"
                >Neon:</label
              >
              <div class="flex gap-2 items-stretch">
                <select
                  id="neon"
                  class="min-w-0 flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"
                >
                  {neonOptions.map((c) => <option value={c}>{c}</option>)}
                </select>
                <div
                  id="neonPrev"
                  class="w-10 h-12 rounded border border-zinc-700 bg-zinc-800 flex-shrink-0"
                >
                </div>
              </div>
            </div>
            <div
              class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700 h-12"
            >
              <input
                type="checkbox"
                id="activator"
                class="w-4 h-4 accent-gold cursor-pointer"
              />
              <label
                for="activator"
                class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest"
                >Activator</label
              >
            </div>
          </div>

          <div
            id="neonRgbArea"
            class="bg-gold/10 p-4 rounded-xl border border-gold/50"
            style="display:none;"
          >
            <label class="block text-[10px] text-gold uppercase font-black mb-2"
              >Neon Crew Color (RGB or HEX):</label
            >
            <div class="flex gap-2 items-stretch">
              <input
                type="text"
                id="neonRgb"
                placeholder="0, 255, 255  or  #00ffff"
                class="min-w-0 flex-1 bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none"
              />
              <div
                id="neonRgbPrev"
                class="w-12 h-12 rounded border border-gold/60 bg-zinc-800 flex-shrink-0"
              >
              </div>
            </div>
          </div>

          <button
            id="generate"
            type="button"
            class="w-full bg-gold hover:bg-gold/90 text-black font-black uppercase py-4 rounded-xl text-sm tracking-widest transition-all"
          >
            Generate DMO Spec
          </button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 sticky top-6"
        >
          <h2
            class="text-sm font-black uppercase tracking-widest text-gold mb-4"
          >
            Output
          </h2>
          <pre
            id="output"
            class="text-xs text-zinc-300 font-mono whitespace-pre-wrap break-all bg-black/50 p-4 rounded-xl border border-zinc-800 min-h-[300px]">
          </pre>
          <button
            id="copy"
            type="button"
            class="mt-4 w-full bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all"
          >
            Copy
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script
  is:inline
  define:vars={{
    allUnselected,
    wheelCategories,
    byTexture,
    preferredRimCats,
    randomizableRimCats,
    wheelImages,
    vividNames,
    realisticNames,
  }}
>
  const hexMap = {};
  allUnselected.forEach((c) => {
    const key = c.texture + "|" + c.name;
    hexMap[key] = c.hex;
  });

  function parseColor(input) {
    if (!input) return null;
    input = input.trim();
    if (input.startsWith("#")) {
      const hex = input.slice(1);
      if (hex.length === 6) {
        const r = parseInt(hex.slice(0, 2), 16);
        const g = parseInt(hex.slice(2, 4), 16);
        const b = parseInt(hex.slice(4, 6), 16);
        if (!isNaN(r) && !isNaN(g) && !isNaN(b)) return `rgb(${r}, ${g}, ${b})`;
      }
    }
    if (input.includes(",")) {
      const parts = input.split(",").map((n) => parseInt(n.trim()));
      if (
        parts.length === 3 &&
        parts.every((n) => !isNaN(n) && n >= 0 && n <= 255)
      ) {
        return `rgb(${parts.join(", ")})`;
      }
    }
    return null;
  }

  function getUnselectedForFlag(flag) {
    return allUnselected.filter((c) => !c[flag]);
  }

  function pickFrom(list, preferred) {
    if (!list || !list.length) return null;
    const preferredHits = list.filter((c) =>
      preferred.some((p) => c.name.toLowerCase().includes(p.toLowerCase())),
    );
    const pool = preferredHits.length ? preferredHits : list;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function makeOption(c) {
    const key = c.texture + "|" + c.name;
    return `<option value="${key}">${c.texture} - ${c.name}</option>`;
  }

  function populatePrimary() {
    const sel = document.getElementById("primary");
    sel.innerHTML =
      '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' +
      allUnselected.map(makeOption).join("");
  }

  function populateSecondary() {
    const sel = document.getElementById("secondary");
    const list = getUnselectedForFlag("secondary");
    sel.innerHTML =
      '<option value="">-- Select --</option><option value="Custom">Custom RGB / HEX</option>' +
      list.map(makeOption).join("");
  }

  function populateUnselectedOnly(selectId, flag) {
    const sel = document.getElementById(selectId);
    const list = getUnselectedForFlag(flag);
    sel.innerHTML =
      '<option value="">-- Select --</option>' + list.map(makeOption).join("");
  }

  function getColorForPreview(id) {
    const sel = document.getElementById(id);
    if (!sel) return "#111";
    const val = sel.value;
    if (val === "Custom" || val === "Crew") {
      const input =
        id === "neon"
          ? document.getElementById("neonRgb").value
          : document.getElementById("sharedRgb").value;
      return parseColor(input) || "#666";
    }
    return hexMap[val] || "#111";
  }

  function refreshPreviews() {
    ["primary", "secondary", "pearl", "interior", "rimColor", "neon"].forEach(
      (id) => {
        const box = document.getElementById(id + "Prev");
        if (box) box.style.backgroundColor = getColorForPreview(id);
      },
    );

    const paintBox = document.getElementById("sharedRgbPrev");
    if (paintBox) {
      const c = parseColor(document.getElementById("sharedRgb").value);
      paintBox.style.backgroundColor = c || "#333";
    }
    const neonBox = document.getElementById("neonRgbPrev");
    if (neonBox) {
      const c = parseColor(document.getElementById("neonRgb").value);
      neonBox.style.backgroundColor = c || "#333";
    }
  }

  function slugify(s) {
    return s
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");
  }

  function getRimImage(cat, style) {
    if (!style || style === "Stock") return null;
    const catSlug = slugify(cat);
    const styleSlug = slugify(style);
    return `/images/wheels/rims/${catSlug}/${styleSlug}.webp`;
  }

  function populateRims() {
    const cat = document.getElementById("wheelCategory").value;
    const sel = document.getElementById("rimStyle");
    const styles = wheelCategories[cat] || [];
    sel.innerHTML = styles
      .map((s) => `<option value="${s}">${s}</option>`)
      .join("");
    updateRimThumb();
  }

  function updateRimThumb() {
    const cat = document.getElementById("wheelCategory").value;
    const style = document.getElementById("rimStyle").value;
    const rimImg = getRimImage(cat, style);
    const catImg = wheelImages[cat] || wheelImages["Bennys Bespoke"];
    const thumb = document.getElementById("wheelThumb");
    const full = document.getElementById("wheelFull");
    if (rimImg) {
      thumb.src = rimImg;
      full.src = rimImg;
      thumb.onerror = () => {
        thumb.src = catImg;
      };
      full.onerror = () => {
        full.src = catImg;
      };
    } else {
      thumb.src = catImg;
      full.src = catImg;
    }
  }

  document
    .getElementById("rimStyle")
    .addEventListener("change", updateRimThumb);

  function randomFrom(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  function randomMutedRgb() {
    const base = 50 + Math.floor(Math.random() * 100);
    const vary = () =>
      Math.max(25, Math.min(190, base + Math.floor(Math.random() * 40) - 20));
    return `${vary()}, ${vary()}, ${vary()}`;
  }

  function randomVividRgb() {
    const r = Math.floor(Math.random() * 256);
    const g = Math.floor(Math.random() * 256);
    const b = Math.floor(Math.random() * 256);
    return `${r}, ${g}, ${b}`;
  }

  function randomBuild(mode) {
    const isVivid = mode === "vivid";
    document.getElementById("vehicle").value = "";
    document.getElementById("plate").value = "";
    document.getElementById("windows").value = randomFrom(windowTints);
    document.getElementById("headlights").value = randomFrom(
      neonOptions.filter((c) => c !== "Crew"),
    );
    document.getElementById("texture").value = randomFrom(
      textureOrder.filter((t) => byTexture[t]),
    );

    const primaryList = allUnselected;
    const secondaryList = getUnselectedForFlag("secondary");
    const pearlList = getUnselectedForFlag("pearl");
    const rimList = getUnselectedForFlag("rim");
    const interiorList = getUnselectedForFlag("interior");

    const preferred = isVivid ? vividNames : realisticNames;

    const primary = pickFrom(primaryList, preferred);
    const secondary = pickFrom(secondaryList, preferred);
    const pearl = pickFrom(pearlList, preferred);
    const rim = pickFrom(rimList, preferred);
    const interior = pickFrom(interiorList, preferred);

    document.getElementById("primary").value = primary
      ? primary.texture + "|" + primary.name
      : "";
    document.getElementById("secondary").value = secondary
      ? secondary.texture + "|" + secondary.name
      : "";
    document.getElementById("pearl").value = pearl
      ? pearl.texture + "|" + pearl.name
      : "";
    document.getElementById("rimColor").value = rim
      ? rim.texture + "|" + rim.name
      : "";
    document.getElementById("interior").value = interior
      ? interior.texture + "|" + interior.name
      : "";

    if (isVivid && Math.random() < 0.4) {
      document.getElementById("primary").value = "Custom";
      document.getElementById("sharedRgb").value = randomVividRgb();
    }
    if (!isVivid && Math.random() < 0.3) {
      document.getElementById("pearl").value = "Worn|Black";
    }

    const neonChoice =
      Math.random() < 0.5
        ? "Crew"
        : randomFrom(neonOptions.filter((c) => c !== "Crew"));
    document.getElementById("neon").value = neonChoice;
    if (neonChoice === "Crew") {
      document.getElementById("neonRgb").value = isVivid
        ? randomVividRgb()
        : randomMutedRgb();
    }

    const rimCat = randomFrom(randomizableRimCats);
    document.getElementById("wheelCategory").value = rimCat;
    populateRims();
    const styles = wheelCategories[rimCat] || [];
    if (styles.length)
      document.getElementById("rimStyle").value = randomFrom(styles);

    refreshPreviews();
    updateRimThumb();
  }

  document.getElementById("texture").addEventListener("change", () => {
    populatePrimary();
    populateSecondary();
    refreshPreviews();
  });

  document
    .getElementById("wheelCategory")
    .addEventListener("change", populateRims);

  document.getElementById("primary").addEventListener("change", () => {
    const isCustom =
      document.getElementById("primary").value === "Custom" ||
      document.getElementById("secondary").value === "Custom";
    document.getElementById("rgbInputArea").style.display = isCustom
      ? "block"
      : "none";
    refreshPreviews();
  });

  document.getElementById("secondary").addEventListener("change", () => {
    const isCustom =
      document.getElementById("primary").value === "Custom" ||
      document.getElementById("secondary").value === "Custom";
    document.getElementById("rgbInputArea").style.display = isCustom
      ? "block"
      : "none";
    refreshPreviews();
  });

  document.getElementById("neon").addEventListener("change", () => {
    const isCrew = document.getElementById("neon").value === "Crew";
    document.getElementById("neonRgbArea").style.display = isCrew
      ? "block"
      : "none";
    refreshPreviews();
  });

  document
    .getElementById("sharedRgb")
    .addEventListener("input", refreshPreviews);
  document.getElementById("neonRgb").addEventListener("input", refreshPreviews);

  document
    .getElementById("randomVivid")
    .addEventListener("click", () => randomBuild("vivid"));
  document
    .getElementById("randomRealistic")
    .addEventListener("click", () => randomBuild("realistic"));

  document.getElementById("expandWheel").addEventListener("click", () => {
    document.getElementById("wheelExpanded").classList.remove("hidden");
  });
  document.getElementById("collapseWheel").addEventListener("click", () => {
    document.getElementById("wheelExpanded").classList.add("hidden");
  });

  document.getElementById("generate").addEventListener("click", () => {
    const get = (id) => document.getElementById(id).value || "";
    const formatColor = (val) => {
      if (!val) return "N/A";
      if (val === "Custom") {
        const rgb = get("sharedRgb");
        return rgb ? `Custom RGB/HEX (${rgb})` : "Custom RGB/HEX";
      }
      const parts = val.split("|");
      return parts.length === 2 ? `${parts[0]} - ${parts[1]}` : val;
    };
    const formatNeon = (val) => {
      if (val === "Crew") {
        const rgb = get("neonRgb");
        return rgb ? `Crew (${rgb})` : "Crew";
      }
      return val || "N/A";
    };
    const plate = get("plate").trim() || "Blankton";
    const out = `=== DMO SPEC ===
Vehicle: ${get("vehicle") || "N/A"}
Plate: ${plate}
Windows: ${get("windows")}
Headlights: ${get("headlights")}
Texture: ${get("texture")}
Primary: ${formatColor(get("primary"))}
Secondary: ${formatColor(get("secondary"))}
Pearlescent: ${formatColor(get("pearl"))}
Interior: ${formatColor(get("interior"))}
Wheel Category: ${get("wheelCategory")}
Rim Style: ${get("rimStyle")}
Rim Color: ${formatColor(get("rimColor"))}
Tires: ${get("tires")}
Neon: ${formatNeon(get("neon"))}
Activator: ${document.getElementById("activator").checked ? "Yes" : "No"}
Same Custom on Both: ${document.getElementById("crewBoth").checked ? "Yes" : "No"}`;
    document.getElementById("output").textContent = out;
  });

  document.getElementById("copy").addEventListener("click", () => {
    const text = document.getElementById("output").textContent;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById("copy");
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = orig), 1500);
    });
  });

  populatePrimary();
  populateSecondary();
  populateUnselectedOnly("pearl", "pearl");
  populateUnselectedOnly("interior", "interior");
  populateUnselectedOnly("rimColor", "rim");
  populateRims();
  refreshPreviews();
</script>
