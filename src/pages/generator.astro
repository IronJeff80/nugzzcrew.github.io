---
import MainLayout from '../layouts/MainLayout.astro';
import colors from '../data/colors.json';

const unselectedColors = colors.filter(c => 
  !c.primary || !c.secondary || !c.pearl || !c.rim || !c.interior
);

const byTexture = {};
unselectedColors.forEach(c => {
  if (!byTexture[c.texture]) byTexture[c.texture] = [];
  byTexture[c.texture].push(c);
});

const textureOrder = ["Chrome", "Hidden", "Other", "Metallic", "Rim", "Utility", "Metals", "Matte", "Worn"];

const wheelCategories = {
  "Bennys Bespoke": ["Stock", "Chrome OG Hunnels", "Gold OG Hunnels", "Chrome Wires", "Gold Wires", "Chrome Spoked Out", "Gold Spoked Out", "Chrome Knock-Offs", "Gold Knock-Offs", "Chrome Bigger Worm", "Gold Bigger Worm", "Chrome Vintage Wire", "Gold Vintage Wire", "Chrome Classic Wire", "Gold Classic Wire", "Chrome Smoothie", "Gold Smoothie", "Chrome Classic Rod", "Gold Classic Rod", "Chrome Dollar", "Gold Dollar", "Chrome Mighty Star", "Gold Mighty Star", "Chrome Decadent Dish", "Gold Decadent Dish", "Chrome Razor Style", "Gold Razor Style", "Chrome Celtic Knot", "Gold Celtic Knot", "Chrome Warrior Dish", "Gold Warrior Dish", "Gold Big Dog Spokes"],
  "Bennys Originals": ["Stock", "OG Hunnels", "OG Hunnels (Chrome Lip)", "Knock-Offs", "Knock-Offs (Chrome Lip)", "Spoked Out", "Spoked Out (Chrome Lip)", "Vintage Wire", "Vintage Wire (Chrome Lip)", "Smoothie", "Smoothie (Chrome Lip)", "Smoothie (Solid Color)", "Rod Me Up", "Rod Me Up (Chrome Lip)", "Rod Me Up (Solid Color)", "Clean", "Lotta Chrome", "Spindles", "Viking", "Triple Spoke", "Pharaoh", "Tiger Style", "Three Wheelin", "Big Bar", "Biohazard", "Waves", "Lick Lick", "Spiralizer", "Hypnotics", "Psycho-Delle", "Half Cut", "Super Electric"],
  "Race": ["Stock", "Classic 5", "Classic 5 (Striped)", "Retro Star", "Retro Star (Striped)", "Triplex", "Triplex (Striped)", "70s Spec", "70s Spec (Striped)", "Super 5R", "Super 5R (Striped)", "Speedster", "Speedster (Striped)", "GP-90", "GP-90 (Striped)", "Superspoke", "Superspoke (Striped)", "Gridline", "Gridline (Striped)", "Snowflake", "Snowflake (Striped)"],
  "Bike": ["Stock", "Speedway", "Street Special", "Racer", "Track Star", "Overlord", "Trident", "Triple Threat", "Stiletto", "Wires", "Bobber", "Solidus", "Ice Shield", "Loops", "Romper Racing", "Warp Drive", "Snowflake", "Holy Spoke", "Old Skool Triple", "Futura", "Quarter Mile King", "Cartwheel", "Double Five", "Shrunken", "Simple Six", "Celtic", "Razer", "Twisted", "Morning Star", "Jagged Spokes", "Eidolon", "Enigma", "Big Spokes", "Webs", "Hotplate", "Bobsta"],
  "High End": ["Stock", "Shadow", "Hypher", "Blade", "Diamond", "Supa Gee", "Chromatic Z", "Mercie Chip", "Obey RS", "GT Chrome", "Cheetah RR", "Solar", "Split Ten", "Dash VIP", "LozSpeed Ten", "Carbon Inferno", "Carbon Shadow", "Carbon Z", "Carbon Solar", "Cheetah Carbon R", "Carbon S Racer"],
  "Lowrider": ["Stock", "Flare", "Wired", "Triple Golds", "Big Worm", "Seven Fives", "Split Six", "Fresh Mesh", "Lead Sled", "Turbine", "Super Fin", "Classic Rod", "Dollar", "Dukes", "Low Five", "Gooch"],
  "Muscle": ["Stock", "Classic Five", "Dukes", "Muscle Freak", "Kracka", "Azreal", "Mecha", "Black Top", "Drag SPL", "Revolver", "Classic Rod", "Fairlie", "Spooner", "Five Star", "Old School", "El Jefe", "Dodman", "Six Gun", "Mercenary"],
  "Offroad": ["Stock", "Raider", "Mudslinger", "Nevis", "Cairngorm", "Amazon", "Challenger", "Dune Basher", "Five Star", "Rock Crawler", "Mil Spec Steele", "Retro Steele", "Heavy Duty Steele", "Concave Steele", "Police Issue Steele", "Lightweight Steele", "Dukes", "Avalanche", "Mountain Man", "Ridge Climber", "Concave 5", "Flat Six", "All Terrain Monster", "Drag SPL", "Concave Rally Master", "Rugged Snowflake"],
  "Sport": ["Stock", "Inferno", "Deep Five", "Lozspeed Mk.V", "Diamond Cut", "Chrono", "Feroci RR", "Fifty Nine", "Mercie", "Synthetic Z", "Organic Type 0", "Endo v1", "GT One", "Duper 7", "Uzer", "Ground Ride", "S Racer", "Venum", "Cosmo", "Dash VIP", "Ice Kid", "Ruff Weld", "Wangan Master", "Super Five", "Endo v2", "Split Six"],
  "Street": ["Stock", "Retro Steele", "Poverty Spec Steele", "Concave Steele", "Nebula", "Hotting Steele", "Cup Champion", "Stance EG Custom", "Kracka Custom", "Dukes Custom", "Endo v.3 Custom", "V8 Killer", "Fujiwara Custom", "Cosmo MkII", "Aero Star", "Hype Five", "Ruff Weld Mega Deep", "Mercie Concave", "Sugoi Concave", "Synthetic Z Concave", "Endo v.4 Dished", "Hyperfresh", "Truffade Concave", "Organic Type II", "Big Manila", "Deep Flake", "Cosmo MkIII", "Concave Racer", "Deep Flake Reverse", "Wild Wagon", "Concave Mega Mesh"],
  "SUV": ["Stock", "VIP", "Benefactor", "Cosmo", "Bippu", "Royal Six", "Fagorme", "Deluxe", "Iced Out", "Cognoscenti", "LozSpeed Ten", "Supernova", "Obey RS", "LozSpeed Baller", "Extravaganzo", "Split Six", "Empowered", "Sunrise", "Dash VIP", "Cutter"],
  "Track": ["Stock", "Rally Throwback", "Grabel Trap", "Stove Top", "Stove Top Mesh", "Retro 3 Piece", "Rally Monoblock", "Forged 5", "Split Star", "Speed Boy", "30s Running", "Tropos", "Exos", "High Five", "Super Luxe", "Pure Business", "Pepper Pot", "Blacktop Blender", "Throwback", "Expressway", "Hidden Six", "Dinka SPL", "Retro Turbofan", "Conical Turbofan", "Ice Storm", "Super Turbine", "Modern Mesh", "Forged Star", "Snowflake", "Giga Mesh", "Mesh Meister"],
  "Tuner": ["Stock", "Cosmo", "Super Mesh", "Outsider", "Rollas", "Driftmeister", "Slicer", "El Quatre", "Dubbed", "Five Star", "Slideways", "Apex", "Stanced EG", "Countersteer", "Endo v1", "Endo v2 Dish", "Gruppe Z", "Choku-Dori", "Chicane", "Saisoku", "Dished Eight", "Fujiwara", "Zokusha", "Battle VIII", "Rally Master"]
};

const wheelImages = {
  "Bennys Bespoke": "/images/wheels/bennys-bespoke.png",
  "Bennys Originals": "/images/wheels/bennys-originals.png",
  "Race": "/images/wheels/race.png",
  "Bike": "/images/wheels/bike.png",
  "High End": "/images/wheels/high-end.png",
  "Lowrider": "/images/wheels/lowrider.png",
  "Muscle": "/images/wheels/muscle.png",
  "Offroad": "/images/wheels/offroad.png",
  "Sport": "/images/wheels/sport.png",
  "Street": "/images/wheels/street.png",
  "SUV": "/images/wheels/suv.png",
  "Track": "/images/wheels/track.png",
  "Tuner": "/images/wheels/tuner.png"
};

const preferredRimCats = ["Bennys Bespoke", "Bennys Originals", "Race"];
const tireDesigns = ["None", "White lines", "Classic", "Retro", "Red", "Blue"];
const windowTints = ["Clear", "Green", "Light Smoke", "Dark Smoke", "Limo", "Pure Black"];
const plateTypes = ["Blue on White 1", "Blue on White 2", "Blue on White 3", "Yellow on Blue", "Yellow on Black", "North Yankton"];
const headlightAndNeonColors = ["Default", "Pure White", "Blue", "Electric Blue", "Mint Green", "Lime Green", "Yellow", "Golden Shower", "Orange", "Red", "Poncho Pink", "Hot Pink", "Purple", "Blacklight"];
---

<MainLayout title="DMO Generator" description="Unselected-only GTA Online DMO generator with vivid/realistic randomizers and wheel previews. Official Nugzz Crew.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-header text-gold uppercase tracking-tighter mb-2">DMO Generator</h1>
      <p class="text-zinc-400 uppercase text-xs tracking-[0.2em]">Unselected Colors Only • Benny/Race Preferred • Compact Wheel Preview</p>
    </div>

    <input type="color" id="colorPicker" class="sr-only" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-7 bg-zinc-900/40 p-6 rounded-3xl border border-zinc-800 space-y-6">
        
        <div class="flex gap-3">
          <button id="randomVivid" type="button" class="flex-1 bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">
            Random Vivid (Benny/Race)
          </button>
          <button id="randomRealistic" type="button" class="flex-1 bg-gradient-to-r from-zinc-600 to-zinc-800 hover:from-zinc-500 hover:to-zinc-700 text-white font-black uppercase py-3 rounded-xl text-xs tracking-widest transition-all">
            Random Realistic
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Vehicle:</label>
            <input type="text" id="vehicle" placeholder="e.g. Buffalo STX" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Plate Text:</label>
              <input type="text" id="plate" maxlength="8" placeholder="NUGZZ" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm uppercase font-mono outline-none focus:border-gold" />
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Plate Type:</label>
              <select id="plateType" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {plateTypes.map(p => <option value={p}>{p}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Window Tint:</label>
              <select id="windows" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {windowTints.map(w => <option value={w}>{w}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Headlight Color:</label>
              <select id="headlights" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {headlightAndNeonColors.map(h => <option value={h}>{h}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Paint Texture:</label>
            <select id="texture" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
              {textureOrder.filter(t => byTexture[t]).map(t => <option value={t}>{t}</option>)}
            </select>
            <p class="text-[9px] text-zinc-500 mt-1">Only unselected/unobtainable colors. Chrome hides color • Matte/Worn make pearls pop.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Primary (unselected only):</label>
              <div class="flex gap-2 items-center">
                <select id="primary" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="primaryPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Secondary (unselected only):</label>
              <div class="flex gap-2 items-center">
                <select id="secondary" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="secondaryPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700">
            <input type="checkbox" id="crewBoth" class="w-4 h-4 accent-gold cursor-pointer" />
            <label for="crewBoth" class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest">Crew Color on BOTH Primary & Secondary</label>
          </div>

          <div id="rgbInputArea" class="bg-gold/10 p-4 rounded-xl border border-gold/50" style="display:none;">
            <label class="block text-[10px] text-gold uppercase font-black mb-2">Crew / Custom RGB:</label>
            <input type="text" id="sharedRgb" placeholder="212, 175, 55" class="w-full bg-black border-2 border-gold rounded-lg p-3 text-white text-sm font-mono outline-none" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Pearlescent (unselected):</label>
              <div class="flex gap-2 items-center">
                <select id="pearl" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="pearlPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Interior / Trim (unselected):</label>
              <div class="flex gap-2 items-center">
                <select id="interior" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="interiorPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Wheel Category:</label>
              <select id="wheelCategory" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {Object.keys(wheelCategories).map(cat => <option value={cat}>{cat}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Rim Style:</label>
              <select id="rimStyle" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <img id="wheelThumb" src="/images/wheels/bennys-bespoke.png" alt="Wheel category" class="w-24 h-16 object-cover rounded border border-zinc-700 cursor-pointer hover:border-gold transition-all" />
            <button id="expandWheel" type="button" class="text-[10px] text-zinc-400 uppercase tracking-widest hover:text-gold">Click thumb or here to expand full grid</button>
          </div>

          <div id="wheelExpanded" class="hidden mt-2">
            <img id="wheelFull" src="/images/wheels/bennys-bespoke.png" alt="Full wheel grid" class="w-full rounded-lg border border-zinc-700 max-h-96 object-contain bg-black" />
            <button id="collapseWheel" type="button" class="mt-2 text-[10px] text-zinc-500 uppercase tracking-widest hover:text-gold">Collapse</button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Rim Color (unselected):</label>
              <div class="flex gap-2 items-center">
                <select id="rimColor" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold"></select>
                <div id="rimColorPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
            <div>
              <label class="block text-[10px] text-zinc-500 uppercase font-black mb-1">Tire Design:</label>
              <select id="tires" class="w-full bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                {tireDesigns.map(d => <option value={d}>{d}</option>)}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-500 uppercase font-black">Neon Color:</label>
              <div class="flex gap-2 items-center">
                <select id="neon" class="flex-1 bg-black border border-zinc-800 rounded-lg p-3 text-white text-sm outline-none focus:border-gold">
                  {headlightAndNeonColors.map(c => <option value={c}>{c}</option>)}
                </select>
                <div id="neonPrev" class="w-8 h-12 rounded border border-zinc-700 bg-zinc-800 shrink-0"></div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-zinc-800/50 rounded-lg border border-zinc-700 h-[46px]">
              <input type="checkbox" id="activator" class="w-4 h-4 accent-gold cursor-pointer" />
              <label for="activator" class="text-[10px] text-zinc-300 uppercase font-black cursor-pointer tracking-widest">Activator</label>
            </div>
          </div>
        </div>

        <button id="mainGenerateBtn" type="button" class="w-full bg-gold hover:bg-white text-black font-black uppercase py-5 rounded-xl tracking-widest transition-all">
          Generate DMO Spec
        </button>
      </div>

      <div class="lg:col-span-5">
        <div class="sticky top-24">
          <div class="bg-black border-2 border-dashed border-zinc-800 rounded-3xl p-6">
            <textarea id="finalOutput" readonly class="bg-transparent font-mono text-sm h-[640px] w-full resize-none outline-none border-none text-gold" placeholder="Ready for NUGZZ..."></textarea>
            <button id="copyFinal" type="button" class="mt-4 w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold uppercase py-4 rounded-xl transition-all">
              Copy To Clipboard
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ unselectedColors, wheelCategories, byTexture, preferredRimCats, wheelImages }}>
  const hexMap = {};
  unselectedColors.forEach(c => { hexMap[c.name] = c.hex; });

  function getUnselected(texture, flag) {
    return (byTexture[texture] || []).filter(c => !c[flag]);
  }

  function populateSelect(selectId, texture, flag) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    const list = getUnselected(texture, flag);
    sel.innerHTML = '<option value="">-- Unselected Only --</option>' + 
      list.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
  }

  function refreshPreviews() {
    ['primary','secondary','pearl','interior','rimColor','neon'].forEach(id => {
      const sel = document.getElementById(id);
      const box = document.getElementById(id + 'Prev');
      if (!sel || !box) return;
      const name = sel.value;
      box.style.backgroundColor = hexMap[name] || '#111';
    });
  }

  function refreshAll() {
    const texture = document.getElementById('texture').value;
    populateSelect('primary', texture, 'primary');
    populateSelect('secondary', texture, 'secondary');
    populateSelect('pearl', texture, 'pearl');
    populateSelect('interior', texture, 'interior');
    populateSelect('rimColor', texture, 'rim');
    refreshPreviews();
  }

  function populateRims() {
    const cat = document.getElementById('wheelCategory').value;
    const sel = document.getElementById('rimStyle');
    const styles = wheelCategories[cat] || [];
    sel.innerHTML = styles.map(s => `<option value="${s}">${s}</option>`).join('');

    const imgSrc = wheelImages[cat] || wheelImages["Bennys Bespoke"];
    document.getElementById('wheelThumb').src = imgSrc;
    document.getElementById('wheelFull').src = imgSrc;
  }

  function randomFrom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function randomBuild(vivid) {
    const texture = vivid 
      ? randomFrom(['Other','Matte','Metallic','Worn']) 
      : randomFrom(['Metallic','Utility','Worn','Metals']);
    document.getElementById('texture').value = texture;
    refreshAll();

    const primaries = getUnselected(texture, 'primary');
    const secondaries = getUnselected(texture, 'secondary');
    const pearls = getUnselected(texture, 'pearl');
    const interiors = getUnselected(texture, 'interior');
    const rims = getUnselected(texture, 'rim');

    if (primaries.length) document.getElementById('primary').value = randomFrom(primaries).name;
    if (secondaries.length) document.getElementById('secondary').value = randomFrom(secondaries).name;
    if (pearls.length) document.getElementById('pearl').value = randomFrom(pearls).name;
    if (interiors.length) document.getElementById('interior').value = randomFrom(interiors).name;
    if (rims.length) document.getElementById('rimColor').value = randomFrom(rims).name;

    const cat = vivid 
      ? randomFrom(preferredRimCats) 
      : randomFrom(Object.keys(wheelCategories));
    document.getElementById('wheelCategory').value = cat;
    populateRims();
    const styles = wheelCategories[cat];
    if (styles.length) document.getElementById('rimStyle').value = randomFrom(styles);

    refreshPreviews();
  }

  document.getElementById('texture').addEventListener('change', refreshAll);
  document.getElementById('wheelCategory').addEventListener('change', populateRims);
  ['primary','secondary','pearl','interior','rimColor','neon'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', refreshPreviews);
  });

  document.getElementById('randomVivid').addEventListener('click', () => randomBuild(true));
  document.getElementById('randomRealistic').addEventListener('click', () => randomBuild(false));

  document.getElementById('wheelThumb').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.toggle('hidden');
  });
  document.getElementById('expandWheel').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.remove('hidden');
  });
  document.getElementById('collapseWheel').addEventListener('click', () => {
    document.getElementById('wheelExpanded').classList.add('hidden');
  });

  document.getElementById('mainGenerateBtn').addEventListener('click', () => {
    const get = id => document.getElementById(id).value || 'N/A';
    const output = `=== DMO SPEC (UNSELECTED ONLY) ===
Vehicle: ${get('vehicle')}
Plate: ${get('plate')} (${get('plateType')})
Windows: ${get('windows')}
Headlights: ${get('headlights')}
Texture: ${get('texture')}
Primary: ${get('primary')}
Secondary: ${get('secondary')}
Pearlescent: ${get('pearl')}
Interior: ${get('interior')}
Wheel Category: ${get('wheelCategory')}
Rim Style: ${get('rimStyle')}
Rim Color: ${get('rimColor')}
Tires: ${get('tires')}
Neon: ${get('neon')}
Activator: ${document.getElementById('activator').checked ? 'Yes' : 'No'}
Crew Both: ${document.getElementById('crewBoth').checked ? 'Yes' : 'No'}
`;
    document.getElementById('finalOutput').value = output;
  });

  document.getElementById('copyFinal').addEventListener('click', () => {
    const box = document.getElementById('finalOutput');
    box.select();
    document.execCommand('copy');
    alert('Copied!');
  });

  refreshAll();
  populateRims();
</script>
