---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Official Nugzz Crew — Streaming, GTA updates, community tools, and the best Fam Bam on the internet." } = Astro.props;
import '../styles/global.css';

const channelJoinUrl = "https://www.youtube.com/channel/UCYNmnbEgm3G0m4avmwz_4Eg/join?v=dummy";

const socials = [
  { name: 'YouTube', url: channelJoinUrl, img: 'YouTube Logo.png' },
  { name: 'Twitch', url: 'https://www.twitch.tv/officialnugzzcrew', img: 'Twitch Logo.png' },
  { name: 'Kick', url: 'https://kick.com/officialnugzzcrew', img: 'Kick Logo.png' },
  { name: 'Discord', url: 'https://discord.gg/officialnugzzcrew', img: 'Discord Logo.png' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@officialnugzzcrew', img: 'TikTok Logo.png' },
  { name: 'Instagram', url: 'https://www.instagram.com/officialnugzzcrew', img: 'IG Logo.png' },
  { name: 'X', url: 'https://x.com/NugzzCrew', img: 'X Logo.png' },
  { name: 'Facebook', url: 'https://www.facebook.com/nugzzcrew', img: 'FB Logo.png' },
  { name: 'Snapchat', url: 'https://www.snapchat.com/add/nugzzcrew', img: 'SnapChat Logo.png' },
  { name: 'Suno', url: 'https://suno.com/@officialnugzzcrew', img: 'Suno Logo.png' },
  { name: 'Shop', url: 'https://officialnugzzcrew-shop.fourthwall.com', img: 'FourthWall Logo.png' },
  { name: 'Crew', url: 'https://socialclub.rockstargames.com/crew/official_nugzz_crew', img: 'Rockstar Logo.png' },
];

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/gta', label: 'GTA Bonuses' },
  { href: '/generator', label: 'DMO Gen' },
  { href: '/gtaresources', label: 'GTA Resources' },
  { href: '/emblem', label: 'Emblem Creator' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '/index.html';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const isHomePage = currentPath === '/' || currentPath === '/index.html';
const siteUrl = 'https://officialnugzzcrew.com';
const desktopLinks = navLinks.slice(1);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title} | Official Nugzz Crew</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#000000" />
        <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />

        <!-- Open Graph / Social -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Official Nugzz Crew" />
        <meta property="og:title" content={`${title} | Official Nugzz Crew`} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
        <meta property="og:image" content={`${siteUrl}/Logo.png`} />

        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={`${title} | Official Nugzz Crew`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={`${siteUrl}/Logo.png`} />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
        <link rel="apple-touch-icon" href="/icon-192.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Preload custom font -->
        <link rel="preload" href="/fonts/HighspeedRegular-8MrOn.otf" as="font" type="font/otf" crossorigin />

        <script src="https://unpkg.com/lucide@latest"></script>
    </head>
    <body class="bg-black text-white antialiased">
        <div id="cursor-dot" aria-hidden="true"></div>
        <div id="cursor-ring" aria-hidden="true"></div>

        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-black focus:text-gold focus:px-4 focus:py-2 focus:rounded-lg focus:outline-gold">
            Skip to content
        </a>

        <nav id="site-header" class="sticky top-0 z-50 bg-black/95 backdrop-blur-md border-b border-zinc-800 px-3 py-3 md:px-4 md:pt-3 md:pb-2">
            <div class="max-w-7xl mx-auto flex flex-col items-center">
                <div class="relative flex items-center justify-center w-full min-h-[48px]">
                    <button 
                        id="menu-toggle" 
                        aria-label="Open menu" 
                        aria-expanded="false"
                        class="absolute left-0 md:left-2 flex items-center justify-center w-16 h-16 text-zinc-300 hover:text-gold transition-colors md:hidden focus-visible:outline-gold"
                    >
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <a href="/" class="flex items-center gap-2 group transition-opacity hover:opacity-90 focus-visible:outline-gold rounded">
                        <img src="/Logo.png" alt="Official Nugzz Crew Logo" class="w-7 h-7 md:w-9 md:h-9 object-contain" />
                        <span class="text-[clamp(12px,3.2vw,20px)] font-header uppercase tracking-tighter whitespace-nowrap">
                            <span class="text-white">Official</span> <span class="text-gold">Nugzz Crew</span>
                        </span>
                    </a>
                </div>

                <div class="hidden md:flex w-full items-center justify-center flex-wrap gap-1 pt-1">
                    {desktopLinks.map((link) => (
                        <a 
                            href={link.href}
                            aria-current={isActive(link.href) ? 'page' : undefined}
                            class:list={[
                                'px-3 py-1.5 rounded-lg transition-colors uppercase tracking-wider text-xs font-bold focus-visible:outline-gold',
                                isActive(link.href)
                                    ? 'text-gold bg-zinc-900/80'
                                    : 'text-zinc-300 hover:text-gold hover:bg-zinc-900/60'
                            ]}
                        >
                            {link.label}
                        </a>
                    ))}
                </div>
            </div>
        </nav>

        <div id="nav-overlay" class="fixed inset-0 bg-black/60 z-40 hidden"></div>
        <aside 
            id="nav-menu" 
            class="fixed top-0 left-0 h-full w-80 md:w-96 max-w-[90vw] bg-black/98 border-r border-zinc-800 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
            aria-hidden="true"
        >
            <div id="menu-header" class="flex items-center justify-between px-5 border-b border-zinc-800 min-h-[88px]">
                <span class="font-header text-gold text-base uppercase tracking-wider">Menu</span>
                <button id="menu-close" aria-label="Close menu" class="text-zinc-400 hover:text-gold focus-visible:outline-gold rounded">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <nav class="flex flex-col p-5 gap-2">
                {navLinks.map((link) => (
                    <a 
                        href={link.href} 
                        aria-current={isActive(link.href) ? 'page' : undefined}
                        class:list={[
                            'nav-link px-5 py-4 rounded-lg transition-colors uppercase tracking-widest text-base font-bold focus-visible:outline-gold',
                            isActive(link.href)
                                ? 'text-gold bg-zinc-900/70'
                                : 'text-zinc-300 hover:text-gold hover:bg-zinc-900/70'
                        ]}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
        </aside>
        
        <main id="main-content" class="relative z-10">
            <slot /> 
        </main>

        {!isHomePage && (
            <div class="text-center py-8">
                <a 
                    href="/" 
                    class="inline-block px-6 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-gold hover:border-gold hover:bg-zinc-800 transition-all uppercase tracking-widest text-sm font-bold focus-visible:outline-gold"
                >
                    &larr; Back To Home
                </a>
            </div>
        )}

        <footer class="pt-3 pb-3 md:pt-4 md:pb-4 text-center text-zinc-600 text-[10px] uppercase tracking-widest border-t border-zinc-900 mt-4">
            <div class="flex justify-center flex-wrap gap-3 md:gap-4 mb-2">
                {socials.map((social) => (
                    <a 
                        href={social.url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="group transition-transform hover:scale-110 active:scale-95 focus-visible:outline-gold rounded" 
                        title={social.name}
                    >
                        <div class="w-6 h-6 md:w-7 md:h-7 flex items-center justify-center">
                            <img 
                                src={`/images/${social.img}`} 
                                alt={`${social.name} Logo`} 
                                class="w-full h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity" 
                                loading="lazy"
                            />
                        </div>
                    </a>
                ))}
            </div>

            &copy; 2026 Official Nugzz Crew | Built for The Fam Bam
        </footer>

        <script is:inline>
          function initIcons() { if (window.lucide) window.lucide.createIcons(); }
          window.addEventListener('load', initIcons);
          document.addEventListener('astro:page-load', initIcons);

          function initMenu() {
            const toggle = document.getElementById('menu-toggle');
            const closeBtn = document.getElementById('menu-close');
            const menu = document.getElementById('nav-menu');
            const overlay = document.getElementById('nav-overlay');
            const links = document.querySelectorAll('.nav-link');
            const header = document.getElementById('site-header');
            const menuHeader = document.getElementById('menu-header');

            function syncMenuHeaderHeight() {
              if (header && menuHeader) {
                menuHeader.style.minHeight = header.offsetHeight + 'px';
              }
            }
            syncMenuHeaderHeight();
            window.addEventListener('resize', syncMenuHeaderHeight);

            function openMenu() {
              syncMenuHeaderHeight();
              menu.classList.remove('-translate-x-full');
              menu.setAttribute('aria-hidden', 'false');
              overlay.classList.remove('hidden');
              toggle.setAttribute('aria-expanded', 'true');
              document.body.style.overflow = 'hidden';
            }

            function closeMenu() {
              menu.classList.add('-translate-x-full');
              menu.setAttribute('aria-hidden', 'true');
              overlay.classList.add('hidden');
              toggle.setAttribute('aria-expanded', 'false');
              document.body.style.overflow = '';
            }

            toggle?.addEventListener('click', openMenu);
            closeBtn?.addEventListener('click', closeMenu);
            overlay?.addEventListener('click', closeMenu);
            links.forEach(link => link.addEventListener('click', closeMenu));

            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') closeMenu();
            });
          }

          window.addEventListener('load', initMenu);
          document.addEventListener('astro:page-load', initMenu);

          (function initFx() {
            if (window.__nugzzFx) return;
            window.__nugzzFx = true;

            const dot = document.getElementById('cursor-dot');
            const ring = document.getElementById('cursor-ring');
            let cursorOn = false;
            let mx = -200, my = -200, rx = -200, ry = -200;

            function armCursor() {
              if (cursorOn || !dot || !ring) return;
              cursorOn = true;
              document.documentElement.classList.add('fx-cursor');
              dot.style.opacity = '1';
              ring.style.opacity = '1';
              function loop() {
                rx += (mx - rx) * 0.22;
                ry += (my - ry) * 0.22;
                ring.style.left = rx + 'px';
                ring.style.top = ry + 'px';
                requestAnimationFrame(loop);
              }
              loop();
            }

            window.addEventListener('mousemove', (e) => {
              mx = e.clientX;
              my = e.clientY;
              armCursor();
              if (dot) {
                dot.style.left = mx + 'px';
                dot.style.top = my + 'px';
              }
            }, { passive: true });

            document.addEventListener('mouseover', (e) => {
              if (!ring || !e.target || !e.target.closest) return;
              ring.classList.toggle('is-hot', !!e.target.closest('a, button, .tilt-card'));
            });

            document.addEventListener('mouseleave', () => {
              if (dot) dot.style.opacity = '0';
              if (ring) ring.style.opacity = '0';
            });
            document.addEventListener('mouseenter', () => {
              if (!cursorOn) return;
              if (dot) dot.style.opacity = '1';
              if (ring) ring.style.opacity = '1';
            });

            function bindTilt() {
              document.querySelectorAll('.tilt-card').forEach((card) => {
                if (card.dataset.tiltBound) return;
                card.dataset.tiltBound = '1';
                const parent = card.parentElement;
                if (parent) parent.style.perspective = '900px';

                card.addEventListener('mousemove', (e) => {
                  const r = card.getBoundingClientRect();
                  const px = (e.clientX - r.left) / r.width - 0.5;
                  const py = (e.clientY - r.top) / r.height - 0.5;
                  card.style.transform = 'rotateX(' + (-py * 16).toFixed(2) + 'deg) rotateY(' + (px * 16).toFixed(2) + 'deg) scale(1.03)';
                });
                card.addEventListener('mouseleave', () => {
                  card.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
                });
              });
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', bindTilt);
            } else {
              bindTilt();
            }
            document.addEventListener('astro:page-load', bindTilt);
          })();
        </script>
    </body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: hidden;

        background-image: url('/Texture-LS-Map-Black.jpg');
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        background-attachment: fixed;
    }

    @media (max-width: 768px) {
        body {
            background-attachment: scroll;
        }
    }

    .text-gold-bright {
        color: #D4AF37;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
    }

    html.fx-cursor,
    html.fx-cursor * {
        cursor: none !important;
    }

    #cursor-dot,
    #cursor-ring {
        position: fixed;
        left: 0;
        top: 0;
        width: 10px;
        height: 10px;
        margin: 0;
        padding: 0;
        border-radius: 9999px;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -50%);
        z-index: 2147483647;
    }

    #cursor-dot {
        background: #FFD700;
        box-shadow: 0 0 0 1px #000, 0 0 12px #FFD700;
    }

    #cursor-ring {
        width: 44px;
        height: 44px;
        background: transparent;
        border: 2px solid #D4AF37;
        box-shadow: 0 0 0 1px #000, 0 0 18px rgba(212, 175, 55, 0.65);
        z-index: 2147483646;
        transition: width 0.18s ease, height 0.18s ease, border-color 0.18s ease;
    }

    #cursor-ring.is-hot {
        width: 68px;
        height: 68px;
        border-color: #FFD700;
    }

    .perspective-wrap {
        perspective: 1200px;
    }

    .tilt-card {
        transform-style: preserve-3d;
        transition: transform 0.08s linear, border-color 0.2s ease;
        will-change: transform;
    }

    /* Theater: player is moved to <body>, so it can cover the nav */
    #video-container.is-theater {
        position: fixed !important;
        inset: 0 !important;
        z-index: 9990 !important;
        width: 100vw !important;
        height: 100dvh !important;
        max-width: none !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        aspect-ratio: auto !important;
        box-shadow: none !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #000 !important;
        overflow: hidden !important;
    }

    #video-container.is-theater #offline-placeholder {
        position: relative !important;
        inset: auto !important;
        width: auto !important;
        height: auto !important;
        max-width: min(1100px, 94vw) !important;
        max-height: 86dvh !important;
        object-fit: contain !important;
        z-index: 1 !important;
    }

    #video-container.is-theater #yt-video-frame:not(.hidden) {
        position: relative !important;
        inset: auto !important;
        display: block !important;
        width: min(96vw, calc(86dvh * 16 / 9)) !important;
        height: min(86dvh, calc(96vw * 9 / 16)) !important;
        max-width: 96vw !important;
        max-height: 86dvh !important;
        z-index: 1 !important;
    }

    #video-container.is-theater #theater-btn {
        position: absolute !important;
        top: 16px !important;
        right: 16px !important;
        bottom: auto !important;
        left: auto !important;
        opacity: 1 !important;
        z-index: 5 !important;
    }

    @media (max-width: 768px) {
        #cursor-dot,
        #cursor-ring {
            display: none !important;
        }
        html.fx-cursor,
        html.fx-cursor * {
            cursor: auto !important;
        }
    }
</style>