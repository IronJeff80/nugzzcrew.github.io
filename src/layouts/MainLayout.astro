---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';

// Use your verified Channel ID with the join trigger
const channelJoinUrl = "https://www.youtube.com/channel/UCYNmnbEgm3G0m4avmwz_4Eg/join?v=dummy";

// Updated to use your local PNG files located in public/images/
const socials = [
  { name: 'YouTube', url: channelJoinUrl, img: 'YouTube Logo.png' },
  { name: 'Twitch', url: 'https://www.twitch.tv/officialnugzzcrew', img: 'Twitch Logo.png' }, 
  { name: 'Kick', url: 'https://kick.com/officialnugzzcrew', img: 'Kick Logo.png' }, 
  { name: 'Discord', url: 'https://discord.gg/officialnugzzcrew', img: 'Discord Logo.png' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@officialnugzzcrew', img: 'TikTok Logo.png' }, 
  { name: 'Instagram', url: 'https://www.instagram.com/officialnugzzcrew', img: 'IG Logo.png' },
  { name: 'X', url: 'https://x.com/NugzzCrew', img: 'X Logo.png' }, 
  { name: 'Facebook', url: 'https://www.facebook.com/nugzzcrew', img: 'FB Logo.png' },
  { name: 'Snapchat', url: 'https://www.snapchat.com/add/nugzzcrew', img: 'SnapChat Logo.png' },
  { name: 'Suno', url: 'https://suno.com/@officialnugzzcrew', img: 'Suno Logo.png' },
  { name: 'Shop', url: 'https://officialnugzzcrew-shop.fourthwall.com', img: 'FourthWall Logo.png' },
  { name: 'Crew', url: 'https://socialclub.rockstargames.com/crew/official_nugzz_crew', img: 'Rockstar Logo.png' },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title} | Official Nugzz Crew</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <link rel="icon" type="image/png" href="/Logo.png" />
        <script src="https://unpkg.com/lucide@latest"></script>
    </head>
    <body class="bg-black text-white antialiased">
        <div id="cursor-dot" aria-hidden="true"></div>
        <div id="cursor-ring" aria-hidden="true"></div>
        <nav class="sticky top-0 z-50 bg-black/95 backdrop-blur-md border-b border-zinc-800 px-3 py-3 md:px-4">
            <div class="max-w-7xl mx-auto flex flex-col items-center gap-3 md:grid md:grid-cols-3 md:gap-0">
   
                <div class="flex md:justify-start w-full justify-center">
                    <a href="/" class="flex items-center gap-2 group transition-opacity hover:opacity-90">
                        <img src="/Logo.png" alt="Logo" class="w-6 h-6 md:w-9 md:h-9 object-contain" />
                        <span class="text-[clamp(11px,3vw,18px)] font-header text-gold uppercase tracking-tighter whitespace-nowrap">
                            Official Nugzz Crew
                        </span>
                    </a>
                </div>

                <div class="flex flex-col items-center gap-1.5 w-full">
                    <div class="flex justify-center gap-4 text-[9px] md:text-xs uppercase font-bold tracking-widest text-zinc-400">
                        <a href="/" class="hover:text-gold transition-colors">Home</a>
                        <a href="/gta" class="hover:text-gold transition-colors">GTA Bonuses</a>
                        <a href="/generator" class="hover:text-gold transition-colors">DMO Gen</a>
                        <a href="/gtaresources" class="hover:text-gold transition-colors">GTA Resources</a>
                        <a href="/emblem" class="hover:text-gold transition-colors">Emblem Creator</a>
                    </div>
                    <a 
                      href={channelJoinUrl} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-[clamp(8px,2vw,10px)] text-gold-bright uppercase tracking-[0.2em] font-black text-center transition-all hover:text-white hover:scale-105 active:scale-95"
                    >
                        Join The Fam Bam Membership
                    </a>
                </div>

                <!-- Custom PNG rendering logic -->
                <div class="flex justify-center md:justify-end gap-1.5 md:gap-3 w-full flex-wrap">
                    {socials.map((social) => (
                        <a href={social.url} target="_blank" rel="noopener noreferrer" class="group transition-transform hover:scale-110 active:scale-95" title={social.name}>
                            <div class="w-4 h-4 md:w-6 md:h-6 flex items-center justify-center">
                                <img 
                                  src={`/images/${social.img}`} 
                                  alt={`${social.name} Logo`} 
                                  class="w-full h-full object-contain opacity-70 group-hover:opacity-100 transition-opacity" 
                                />
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </nav>
        
        <main id="main-content" class="relative z-10">
            <slot /> 
        </main>

        <footer class="p-10 text-center text-zinc-600 text-[10px] uppercase tracking-widest border-t border-zinc-900 mt-20">
            &copy; 2026 Official Nugzz Crew | Built for The Fam Bam
        </footer>

        <script is:inline>
          function initIcons() { if (window.lucide) window.lucide.createIcons(); }
          window.addEventListener('load', initIcons);
          document.addEventListener('astro:page-load', initIcons);

          (function initFx() {
            if (window.__nugzzFx) return;
            window.__nugzzFx = true;
            const dot = document.getElementById('cursor-dot');
            const ring = document.getElementById('cursor-ring');
            let cursorOn = false, mx = -200, my = -200, rx = -200, ry = -200;
            function armCursor() {
              if (cursorOn || !dot || !ring) return;
              cursorOn = true;
              document.documentElement.classList.add('fx-cursor');
              dot.style.opacity = '1';
              ring.style.opacity = '1';
              (function loop() {
                rx += (mx - rx) * 0.22;
                ry += (my - ry) * 0.22;
                ring.style.left = rx + 'px';
                ring.style.top = ry + 'px';
                requestAnimationFrame(loop);
              })();
            }
            window.addEventListener('mousemove', (e) => {
              mx = e.clientX; my = e.clientY; armCursor();
              if (dot) { dot.style.left = mx + 'px'; dot.style.top = my + 'px'; }
            }, { passive: true });
            document.addEventListener('mouseover', (e) => {
              if (!ring || !e.target || !e.target.closest) return;
              ring.classList.toggle('is-hot', !!e.target.closest('a, button, .tilt-card'));
            });
            function bindTilt() {
              if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
              document.querySelectorAll('.tilt-card').forEach((card) => {
                if (card.dataset.tiltBound) return;
                card.dataset.tiltBound = '1';
                card.addEventListener('mousemove', (e) => {
                  const r = card.getBoundingClientRect();
                  const px = (e.clientX - r.left) / r.width - 0.5;
                  const py = (e.clientY - r.top) / r.height - 0.5;
                  card.style.transform = 'rotateX(' + (-py * 14).toFixed(2) + 'deg) rotateY(' + (px * 14).toFixed(2) + 'deg) scale(1.03)';
                });
                card.addEventListener('mouseleave', () => {
                  card.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
                });
              });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindTilt);
            else bindTilt();
            document.addEventListener('astro:page-load', bindTilt);
          })();
        </script>
    </body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        max-width: 100%;
        overflow-x: clip;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: clip; 

        /* ---FIXED BACKGROUND PATH ---*/
        background-image: url('/Texture-LS_Map-Black.png');
        background-repeat: repeat;
        background-size: 2048px 2048px;
        background-attachment: fixed;
    }

    #main-content :is(.tilt-card, .rounded-xl, .rounded-2xl, .rounded-3xl, .rounded-\[2\.5rem\]),
    #video-container {
        box-shadow: 0 0 50px -12px rgba(212, 175, 55, 0.35);
    }

    .tilt-card {
        transform-style: preserve-3d;
        transition: transform 0.08s linear, border-color 0.2s ease, box-shadow 0.2s ease;
        will-change: transform;
    }

    .glow-red:hover {
        border-color: #ef4444 !important;
        box-shadow: 0 0 42px -6px rgba(239, 68, 68, 0.8) !important;
    }
    .glow-purple:hover {
        border-color: #c084fc !important;
        box-shadow: 0 0 42px -6px rgba(192, 132, 252, 0.8) !important;
    }
    .glow-blue:hover {
        border-color: #60a5fa !important;
        box-shadow: 0 0 42px -6px rgba(96, 165, 250, 0.8) !important;
    }

    #cursor-dot, #cursor-ring {
        position: fixed;
        left: 0;
        top: 0;
        border-radius: 9999px;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -50%);
        z-index: 2147483647;
    }
    #cursor-dot {
        width: 10px;
        height: 10px;
        background: #FFD700;
        box-shadow: 0 0 0 1px #000, 0 0 12px #FFD700;
    }
    #cursor-ring {
        width: 44px;
        height: 44px;
        border: 2px solid #D4AF37;
        z-index: 2147483646;
        transition: width 0.18s ease, height 0.18s ease;
    }
    #cursor-ring.is-hot { width: 68px; height: 68px; }
    html.fx-cursor, html.fx-cursor * { cursor: none !important; }

    #video-container.is-theater {
        position: fixed !important;
        inset: 0 !important;
        z-index: 9990 !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        aspect-ratio: auto !important;
        box-shadow: none !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #000 !important;
    }
    #video-container.is-theater #offline-placeholder {
        position: relative !important;
        width: auto !important;
        height: auto !important;
        max-width: min(1100px, 94vw) !important;
        max-height: 86dvh !important;
        object-fit: contain !important;
    }
    #video-container.is-theater #yt-video-frame {
        position: relative !important;
        width: min(96vw, calc(86dvh * 16 / 9)) !important;
        height: min(86dvh, calc(96vw * 9 / 16)) !important;
    }
    #video-container.is-theater #theater-btn {
        position: absolute !important;
        top: 16px !important;
        right: 16px !important;
        bottom: auto !important;
    }

    @media (max-width: 768px) {
        #cursor-dot, #cursor-ring { display: none !important; }
        html.fx-cursor, html.fx-cursor * { cursor: auto !important; }
        body { background-attachment: scroll; }
    }

    .text-gold-bright {
        color: #D4AF37;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
    }
</style>